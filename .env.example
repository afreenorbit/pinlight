# Local API. Frontend: http://localhost:5173
TRACEPOINT_API_PORT=4100

# Server-only. Model ID without the groq/ provider prefix.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Bolna browser conversation. Run npm run configure:bolna after adding the key.
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Durable local domain records and original PDFs. Back up the entire data folder.
DATABASE_PATH=./data/tracepoint.sqlite
DOCUMENTS_DIR=./data/documents

# Wispr Flow is an external desktop dictation application; no app API key required.

# Supabase (accounts, My desk, saved chats). Project Settings -> API. The anon key is public by design;
# row-level security in supabase/migrations/0001_pinlight_desk.sql protects the data. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to on to show sign-in, My desk and saved chats.
VITE_ACCOUNTS=off

# --- Deployment (leave unset locally) ---
# API server (Render): HOST=0.0.0.0 to accept outside traffic; Render provides PORT itself.
# HOST=0.0.0.0
# PUBLIC_HOSTS=api.afreenorbit.tech,pinlight-api.onrender.com
# ALLOWED_ORIGINS=https://pinlight.afreenorbit.tech
# RATE_LIMIT=on
# REPORTS_DIR=/var/data/reports
# Website (Vercel): where the browser finds the API.
# VITE_API_URL=https://api.afreenorbit.tech
